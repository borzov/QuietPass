{
  "manifest_version": 3,
  "name": "QuietPass",
  "version": "1.0.0",
  "description": "Случайные пароли по вашим правилам, вставка в поле и защищённая локальная история.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting", "nativeMessaging"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "QuietPass", "default_icon": {"16":"images/toolbar-16.png", "32":"images/toolbar-32.png"}},
  "icons": {"48":"images/icon-48.png", "128":"images/icon-128.png", "256":"images/icon-256.png", "512":"images/icon-512.png"},
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'"},
  "browser_specific_settings": {"safari":{"strict_min_version":"18.0"}}
}
