{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new password, right in Safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый пароль — прямо в Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中轻松生成新密码"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Passwort – direkt in Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau mot de passe, directement dans Safari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nueva contraseña, directamente en Safari"
          }
        }
      }
    },
    "onboarding.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the extension in Safari. Then click the key icon in the browser toolbar to generate, copy, or insert a password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите расширение в Safari. Затем нажмите значок ключа в панели браузера, чтобы сгенерировать, скопировать или вставить пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Safari 中启用扩展，然后点击浏览器工具栏中的钥匙图标，即可生成、复制或填入密码。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Erweiterung in Safari. Klicken Sie dann auf das Schlüsselsymbol in der Symbolleiste, um ein Passwort zu erstellen, zu kopieren oder einzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’extension dans Safari. Cliquez ensuite sur l’icône de clé dans la barre d’outils pour générer, copier ou insérer un mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la extensión en Safari. Después, haz clic en el icono de llave de la barra del navegador para generar, copiar o insertar una contraseña."
          }
        }
      }
    },
    "onboarding.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension enabled"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение включено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展已启用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterung aktiviert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension activée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión activada"
          }
        }
      }
    },
    "onboarding.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension not enabled yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение пока выключено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展尚未启用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterung noch nicht aktiviert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension pas encore activée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión aún no está activada"
          }
        }
      }
    },
    "onboarding.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking extension status…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем состояние…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查扩展状态…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterungsstatus wird geprüft…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de l’état de l’extension…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando el estado de la extensión…"
          }
        }
      }
    },
    "onboarding.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari Settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Safari 设置"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-Einstellungen öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages de Safari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Safari"
          }
        }
      }
    },
    "onboarding.settingsError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open settings. In Safari, choose Settings → Extensions → QuietPass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть настройки. В Safari выберите «Настройки → Расширения → QuietPass»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开设置。请在 Safari 中选择“设置 → 扩展 → QuietPass”。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen konnten nicht geöffnet werden. Wählen Sie in Safari „Einstellungen → Erweiterungen → QuietPass“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir les réglages. Dans Safari, choisissez Réglages → Extensions → QuietPass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir los ajustes. En Safari, selecciona Ajustes → Extensiones → QuietPass."
          }
        }
      }
    },
    "onboarding.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Options and history are available in the extension. History is stored locally in the macOS Keychain. This setup app closes after opening Safari Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры и история доступны в расширении. История хранится локально в Связке ключей. После перехода в настройки Safari это приложение закрывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选项和历史记录可在扩展中查看。历史记录保存在本地 macOS 钥匙串中。打开 Safari 设置后，此设置应用会自动退出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionen und Verlauf finden Sie in der Erweiterung. Der Verlauf wird lokal im macOS-Schlüsselbund gespeichert. Diese Einrichtungs-App wird nach dem Öffnen der Safari-Einstellungen beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options et l’historique sont disponibles dans l’extension. L’historique est stocké localement dans le trousseau macOS. Cette app de configuration se ferme après avoir ouvert les réglages de Safari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones y el historial están disponibles en la extensión. El historial se guarda localmente en el Llavero de macOS. Esta app de configuración se cierra al abrir los ajustes de Safari."
          }
        }
      }
    },
    "history.keychainLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — password history"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — история паролей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — 密码历史记录"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — Passwortverlauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — historique des mots de passe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "QuietPass — historial de contraseñas"
          }
        }
      }
    }
  },
  "version": "1.0"
}
